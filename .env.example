# ==============================================================================
# StackPulse - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Example local: postgresql://postgres:postgres@localhost:5432/stackpulse?schema=public
# Example cloud: postgres://user:pass@ep-cool-db.us-east-2.aws.neon.tech/stackpulse?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stackpulse?schema=public"

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=stackpulse_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# GitHub API Integration
# Optional but strongly recommended: GitHub Personal Access Token (classic or fine-grained)
# With token: 5,000 requests/hour. Without token: 60 requests/hour.
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Cache Settings (in milliseconds)
# Default: 1 hour (3600000 ms) before refetching GitHub developer data
DEVELOPER_CACHE_TTL_MS=3600000
